@prefix : <http://crispy.ai.wu.ac.at/crisp/> .
@base <http://crispy.ai.wu.ac.at/crisp/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ssn: <http://www.w3.org/ns/ssn/> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sogo: <http://example.org/sogo#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix crisp: <http://crispy.ai.wu.ac.at/crisp/> .


crisp:population rdf:type sogo:ScalingProperty .

crisp:roadLength rdf:type sogo:AuxiliaryProperty .

:CommunityStateMapping rdf:type owl:NamedIndividual , sogo:SpatialMap ;
                           sogo:sourceFeature crisp:Community ;
                           sogo:targetFeature crisp:State ;
                           sogo:mappingQuery """
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX crisp: <http://crispy.ai.wu.ac.at/crisp/>

SELECT * WHERE {
	<SOGO_PART> geo:sfWithin/geo:sfWithin <SOGO_WHOLE> .
    <SOGO_WHOLE> a crisp:State .
    <SOGO_PART> a crisp:Community .
} """ .

:H3CellCommunityMapping rdf:type owl:NamedIndividual ,
                                     sogo:SpatialMap ;
                            sogo:sourceFeature crisp:Community ;
                            sogo:targetFeature crisp:H3Cell ;
                            sogo:mappingQuery """
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX crisp: <http://crispy.ai.wu.ac.at/crisp/>

SELECT * WHERE {
	<SOGO_WHOLE> geo:sfContains <SOGO_PART> .
    <SOGO_WHOLE> a crisp:Community .
    <SOGO_PART> a crisp:H3Cell .
} """ .


###  Downscaling Procedure
:populationDownscaling rdf:type owl:NamedIndividual ,
                                    sogo:ScalingProcedure ;
                           sogo:hasAuxiliaryProperty crisp:roadLength ;
                           sogo:hasScalingProperty crisp:population ;
                           sogo:hasSpatialMap crisp:H3CellCommunityMapping ;
                           sogo:hasTemporalExtent [ rdf:type time:Instant ;
                                                    time:inXSDDateTimeStamp "2011-10-31T00:00:00Z"^^xsd:dateTimeStamp
                                                  ] ;
                           sogo:usesScalingMethod sogo:WeightedDisaggregation ;
                           rdfs:comment "A scaling procedure for estimating H3 cell populations from community-level populations, weighted proportionally by the length of roads within each cell."@en ;
                           rdfs:label "Population Downscaling Procedure"@en .


###  Upscaling Procedure
:populationUpscaling rdf:type owl:NamedIndividual, sogo:ScalingProcedure ;
                         sogo:hasScalingProperty crisp:population ;
                         sogo:hasSpatialMap crisp:CommunityStateMapping ;
                         sogo:hasTemporalExtent [ rdf:type time:Year ;
                                                  time:year "2011"^^xsd:gYear
                                                ] ;
                         sogo:usesScalingMethod sogo:SumAggregation ;
                         rdfs:comment "A scaling procedure for calculating population of states based on community population data."@en ;
                         rdfs:label "Population Upscaling Procedure"@en .


